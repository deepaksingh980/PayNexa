# PayNexa - Environment Configuration Template
# ============================================================
# Copy this file to .env and configure for your deployment.
# NEVER commit .env with real secrets to version control.
# ============================================================

# --- NODE ENVIRONMENT ---
# NODE_ENV is managed by the supervisor: 'production' by `npm start`, 'development' by `npm run dev`.
# NODE_ENV=development

# --- SERVICE PORTS (Strictly Non-Docker Standard Host Topology) ---
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
HELP_PORTAL_PORT=3000
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_WALLET_STORE_PORT=5000

# --- PUBLIC SERVICE URLS ---
BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000
BASE_ADMIN_URL=http://localhost:6001
BASE_HELP_URL=http://localhost:3000
BASE_DEMO_STORE_URL=http://localhost:5000
# Merchant sites allowed to show the checkout in the youpi.js modal (iframe), comma separated.
# Unset = only the portal's own origin may frame it.

# --- DATABASE CONFIGURATION ---
# PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youpi_pg
# SQLite local file fallback for instant zero-dependency testing:
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/youpi_pg.sqlite

# --- CRYPTOGRAPHIC SECRETS & SERVICE TOKENS (Generate using crypto.randomBytes(32).toString('hex')) ---
# Master 256-bit encryption key for sensitive records (OAuth tokens, merchant keys at rest):
ENCRYPTION_MASTER_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARS_GENERATED_BY_crypto_randomBytes_32
# Session & JWT secret (min 32 chars):
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
# Admin REST API Bearer Token (protects /api/v1/admin/* management routes):
ADMIN_API_TOKEN=REPLACE_WITH_64_HEX_CHARS_FOR_ADMIN_API_TOKEN
# Observer Daemon Ingestion Token (authenticates banking SMS & Gmail observer webhook ingesters):
OBSERVER_API_TOKEN=REPLACE_WITH_64_HEX_CHARS_FOR_OBSERVER_API_TOKEN
# Co-located Internal Service Token (verifies loopback SSR proxies and checkout frame rendering):
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_64_HEX_CHARS_FOR_INTERNAL_SERVICE_TOKEN
# Device Credential Signing Key (HMAC key used to sign client device binding credentials & challenges):
DEVICE_CREDENTIAL_KEY=REPLACE_WITH_64_HEX_CHARS_FOR_DEVICE_CREDENTIAL_KEY
# Blind Index Key (Keyed HMAC digest for indexing tokens and phone numbers at rest):
BLIND_INDEX_KEY=REPLACE_WITH_64_HEX_CHARS_FOR_BLIND_INDEX_KEY
# Reference Coin Wallet Store Webhook Secret:
COIN_STORE_WEBHOOK_SECRET=REPLACE_WITH_64_HEX_CHARS_FOR_STORE_WEBHOOK_SECRET
# Default Admin credentials for initial setup:
INITIAL_ADMIN_EMAIL=admin@paynexa.local
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!

# --- NETWORK SECURITY & SSRF CONTROLS ---
# Disallow webhooks pointing to RFC1918 private/loopback IP ranges to prevent SSRF against internal cloud infrastructure:
# Set to 'true' only in local development / self-hosted private LAN setups.
YOUPI_ALLOW_PRIVATE_WEBHOOKS=false
# Disallow synthetic developer payment simulators and fake event injection in production:
YOUPI_ALLOW_DEV_TOOLS=false
# Allow localhost fallback mode when no Cloudflare Tunnel domain is configured:
YOUPI_ALLOW_LOCALHOST_MODE=false

# --- TIMING & QUEUE ENGINE CONSTANTS ---
# Payment active window (milliseconds, default 5 minutes = 300000):
PAYMENT_ACTIVE_WINDOW_MS=300000
# Payment processing verification window (milliseconds, default 30 seconds = 30000):
PAYMENT_PROCESSING_WINDOW_MS=30000
# Late observation grace evaluation window (milliseconds, default 30 minutes = 1800000):
LATE_OBSERVATION_WINDOW_MS=1800000

# --- GMAIL OBSERVER CONFIGURATION ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:6003/oauth/callback
GMAIL_POLL_INTERVAL_MS=5000

# --- SMS / GOOGLE MESSAGES OBSERVER ---
SMS_OBSERVER_POLL_INTERVAL_MS=3000

# --- ANDROID OBSERVER SECURITY ---
ANDROID_ENROLLMENT_SECRET=android_pairing_enrollment_secret_key_32_chars
ANDROID_HEARTBEAT_TIMEOUT_MS=180000

# --- WEBHOOK ENGINE ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000

# --- CHECKOUT PORTAL FRAMING ---
# frame-ancestors CSP for the checkout page. Unset defaults to * in development
# and 'self' in production (NODE_ENV=production or YOUPI_MODE=production); pin
# it to your storefront origins to prevent clickjacking.
# Origins allowed to frame the checkout page (comma or space separated).
# Only bare http(s) origins are accepted; anything else is ignored.
# CHECKOUT_FRAME_ANCESTORS=https://shop.example.com

# --- WHITE-LABEL BRANDING ---
DEFAULT_APP_NAME="PayNexa"
DEFAULT_PRIMARY_COLOR="#0ea5e9"
DEFAULT_SUPPORT_EMAIL="support@paynexa.local"
